@model IPagedList<ContactMessage>
@{
    ViewData["Title"] = "Nachrichten";
    ViewData["Subtitle"] = "Anfragen aus dem Kontaktformular der Website.";
}
<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state"><i class="fas fa-inbox"></i>Der Posteingang ist leer.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th></th><th>Absender</th><th>Betreff</th><th>Datum</th><th class="text-right">Aktionen</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr class="@(m.IsRead ? "" : "font-weight-bold")">
                                <td style="width:30px">@if (!m.IsRead) { <span class="badge badge-primary">Neu</span> }</td>
                                <td>@m.Name<div class="muted-small font-weight-normal">@m.Mail</div></td>
                                <td><a asp-action="Details" asp-route-id="@m.ContactMessageID" class="text-dark">@m.Subject</a><div class="muted-small font-weight-normal">@ViewHelpers.Truncate(m.Message, 80)</div></td>
                                <td class="text-nowrap">@m.MessageDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-right actions">
                                    <a asp-action="Details" asp-route-id="@m.ContactMessageID" class="btn btn-sm btn-light"><i class="fas fa-eye"></i></a>
                                    <form asp-action="Delete" asp-route-id="@m.ContactMessageID" method="post" data-confirm="Nachricht löschen?">
                                        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page }), ViewHelpers.Pager)
