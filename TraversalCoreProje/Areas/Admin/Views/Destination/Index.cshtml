@model IPagedList<DestinationModel>
@{
    ViewData["Title"] = "Reiseziele";
    ViewData["Subtitle"] = "Alle Reiseziele verwalten – aktivieren, bearbeiten oder neue anlegen.";
}
@section HeaderActions {
    <a asp-action="Create" class="btn btn-primary btn-icon icon-left"><i class="fas fa-plus"></i> Neues Reiseziel</a>
}

<div class="card">
    <div class="card-header">
        <form method="get" class="form-inline w-100">
            <div class="input-group" style="max-width:360px">
                <input type="text" name="q" value="@ViewBag.Search" class="form-control" placeholder="Nach Stadt suchen …" />
                <div class="input-group-append"><button class="btn btn-primary"><i class="fas fa-search"></i></button></div>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state"><i class="fas fa-map"></i>Keine Reiseziele gefunden.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>Reiseziel</th><th>Dauer</th><th>Preis</th><th>Kapazität</th><th>Buchungen</th><th>Angelegt von</th><th>Sichtbar</th><th class="text-right">Aktionen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@d.Image" class="table-thumb mr-3" alt="" />
                                        <div>
                                            <div class="font-weight-bold">@d.City</div>
                                            <div class="muted-small">#@d.DestinationID · @ViewHelpers.Truncate(d.Description, 50)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-nowrap">@d.DayNight</td>
                                <td class="text-nowrap font-weight-bold">@ViewHelpers.Euro(d.Price)</td>
                                <td>@d.Capacity</td>
                                <td><span class="badge badge-light">@d.ReservationCount</span></td>
                                <td class="text-nowrap"><img src="@d.userimage" class="avatar-sm mr-1" alt="" /> @d.username @d.usersurname</td>
                                <td>
                                    <label class="custom-switch m-0 p-0">
                                        <input type="checkbox" class="custom-switch-input js-status" data-id="@d.DestinationID" @(d.Status ? "checked" : "")>
                                        <span class="custom-switch-indicator"></span>
                                    </label>
                                </td>
                                <td class="text-right actions">
                                    <a href="@Url.Action("Destiniton", "Destiniton", new { area = "", id = d.DestinationID })" target="_blank" class="btn btn-sm btn-light" title="Auf der Website ansehen"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@d.DestinationID" class="btn btn-sm btn-primary" title="Bearbeiten"><i class="fas fa-pen"></i></a>
                                    <form asp-action="Delete" asp-route-id="@d.DestinationID" method="post" data-confirm="„@d.City“ wirklich löschen? Alle Reservierungen und Kommentare dazu werden ebenfalls gelöscht.">
                                        <button class="btn btn-sm btn-outline-danger" title="Löschen"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.Search }), ViewHelpers.Pager)

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        $('.js-status').on('change', function () {
            var cb = $(this);
            $.post('@Url.Action("ChangeStatus")', {
                id: cb.data('id'), status: cb.is(':checked'),
                __RequestVerificationToken: $('input[name=__RequestVerificationToken]').first().val()
            }).done(function (r) {
                if (window.iziToast) iziToast.success({ title: 'Gespeichert', message: r.updated ? 'Reiseziel ist jetzt sichtbar.' : 'Reiseziel ist jetzt ausgeblendet.', position: 'topRight' });
            }).fail(function () { cb.prop('checked', !cb.is(':checked')); alert('Status konnte nicht geändert werden.'); });
        });
    </script>
}
