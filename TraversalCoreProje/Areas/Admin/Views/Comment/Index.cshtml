@model IPagedList<CommentWithDestinationundUserModel>
@{
    ViewData["Title"] = "Kommentare";
    ViewData["Subtitle"] = "Bewertungen der Kunden prüfen, ausblenden oder löschen.";
    string filter = ViewBag.Filter;
    string Pill(string s) => (filter ?? "") == s ? "active" : "";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<ul class="nav nav-pills filter-pills mb-3">
    <li class="nav-item"><a class="nav-link @Pill("")" asp-action="Index">Alle <span class="badge badge-light">@ViewBag.CountAll</span></a></li>
    <li class="nav-item"><a class="nav-link @Pill("active")" asp-action="Index" asp-route-filter="active">Sichtbar</a></li>
    <li class="nav-item"><a class="nav-link @Pill("inactive")" asp-action="Index" asp-route-filter="inactive">Ausgeblendet <span class="badge badge-warning">@ViewBag.CountInactive</span></a></li>
</ul>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state"><i class="fas fa-comment-slash"></i>Keine Kommentare vorhanden.</div>
        }
        @foreach (var c in Model)
        {
            <div class="comment-item @(c.status ? "" : "inactive")">
                <img src="@c.UserImage" class="avatar-sm" alt="" />
                <div class="comment-body">
                    <div class="d-flex flex-wrap justify-content-between">
                        <div>
                            <a asp-controller="User" asp-action="Comments" asp-route-id="@c.UserID" class="font-weight-bold text-dark">@c.UserName @c.UserSurname</a>
                            <span class="muted-small">zu</span>
                            <a href="@Url.Action("Destiniton", "Destiniton", new { area = "", id = c.DestinationID })" target="_blank" class="font-weight-bold">@c.DesCity</a>
                        </div>
                        <div class="muted-small">@c.CommentData.ToString("dd.MM.yyyy HH:mm") · @ViewHelpers.ActiveBadge(c.status, "Sichtbar", "Ausgeblendet")</div>
                    </div>
                    <p class="mb-2 mt-1">@c.CommentContent</p>
                    <div class="actions">
                        <form asp-action="Toggle" asp-route-id="@c.id" asp-route-returnUrl="@returnUrl" method="post">
                            <button class="btn btn-sm @(c.status ? "btn-light" : "btn-success")">
                                <i class="fas @(c.status ? "fa-eye-slash" : "fa-eye") mr-1"></i>@(c.status ? "Ausblenden" : "Freischalten")
                            </button>
                        </form>
                        <form asp-action="Delate" asp-route-id="@c.id" asp-route-returnUrl="@returnUrl" method="post" data-confirm="Kommentar endgültig löschen?">
                            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash mr-1"></i>Löschen</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page, filter }), ViewHelpers.Pager)
