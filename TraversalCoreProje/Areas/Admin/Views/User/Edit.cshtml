@model UserModel
@{
    ViewData["Title"] = $"Benutzer bearbeiten: {Model.name} {Model.surename}";
}
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    <img id="pv-user" src="@Model.image" class="avatar-lg mb-3" alt="" />
                    <h5 class="mb-1">@Model.name @Model.surename</h5>
                    <div class="mb-3">
                        @foreach (var r in Model.Roles) { <span class="badge badge-light mr-1">@r</span> }
                    </div>
                    <div class="form-group text-left">
                        <label>Neues Profilbild</label>
                        <input type="file" name="ImageFile" accept="image/*" class="form-control" data-preview="#pv-user" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>
                    <a asp-action="AssignRole" asp-route-id="@Model.id" class="btn btn-info btn-block"><i class="fas fa-user-tag mr-1"></i> Rollen zuweisen</a>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><h4>Stammdaten</h4></div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="name">Vorname</label>
                            <input asp-for="name" class="form-control" />
                            <span asp-validation-for="name" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="surename">Nachname</label>
                            <input asp-for="surename" class="form-control" />
                            <span asp-validation-for="surename" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="email">E-Mail</label>
                            <input asp-for="email" class="form-control" />
                            <span asp-validation-for="email" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="phone">Telefon</label>
                            <input asp-for="phone" class="form-control" />
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="gender">Geschlecht</label>
                            <select asp-for="gender" class="form-control">
                                <option value="Frau">Frau</option>
                                <option value="Mann">Mann</option>
                                <option value="Divers">Divers</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-right">
                    <a asp-action="Index" class="btn btn-light">Abbrechen</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Speichern</button>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
