@model IPagedList<UserListItem>
@{
    ViewData["Title"] = "Benutzer";
    ViewData["Subtitle"] = "Alle registrierten Kunden und Mitarbeiter.";
}
@section HeaderActions {
    <a asp-controller="Role" asp-action="Index" class="btn btn-light"><i class="fas fa-user-tag mr-1"></i> Rollen verwalten</a>
}

<div class="card">
    <div class="card-header">
        <form method="get" class="form-inline w-100">
            <div class="input-group" style="max-width:360px">
                <input type="text" name="q" value="@ViewBag.Search" class="form-control" placeholder="Name oder E-Mail …" />
                <div class="input-group-append"><button class="btn btn-primary"><i class="fas fa-search"></i></button></div>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Benutzer</th><th>Telefon</th><th>Rollen</th><th>Reservierungen</th><th>Kommentare</th><th>Registriert</th><th class="text-right">Aktionen</th></tr></thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <div class="d-flex align-items-center">
                                    <img src="@u.Image" class="avatar-sm mr-2" alt="" />
                                    <div>
                                        <div class="font-weight-bold">@u.FullName @if (u.IsProtected) { <i class="fas fa-lock text-muted ml-1" title="Geschütztes Demo-Konto"></i> }</div>
                                        <div class="muted-small">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap">@u.Phone</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge @(r == "Admin" ? "badge-danger" : r == "Moderator" ? "badge-info" : "badge-light") mr-1">@r</span>
                                }
                            </td>
                            <td>@u.ReservationCount</td>
                            <td>@u.CommentCount</td>
                            <td class="text-nowrap">@ViewHelpers.Date(u.CreatedAt)</td>
                            <td class="text-right actions">
                                <a asp-action="Comments" asp-route-id="@u.Id" class="btn btn-sm btn-light" title="Profil &amp; Kommentare"><i class="fas fa-eye"></i></a>
                                <a asp-action="AssignRole" asp-route-id="@u.Id" class="btn btn-sm btn-info" title="Rollen zuweisen"><i class="fas fa-user-tag"></i></a>
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-primary" title="Bearbeiten"><i class="fas fa-pen"></i></a>
                                @if (!u.IsProtected)
                                {
                                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" data-confirm="@u.FullName wirklich löschen? Reservierungen und Kommentare werden ebenfalls gelöscht.">
                                        <button class="btn btn-sm btn-outline-danger" title="Löschen"><i class="fas fa-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.Search }), ViewHelpers.Pager)
