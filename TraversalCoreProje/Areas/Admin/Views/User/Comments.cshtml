@model IPagedList<CommentWithDestinationundUserModel>
@{
    ViewData["Title"] = "Benutzerprofil";
}
@section HeaderActions {
    <a asp-action="Index" class="btn btn-light"><i class="fas fa-arrow-left mr-1"></i> Zur Benutzerliste</a>
}
<div class="row">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center">
                <img src="@ViewBag.UserImage" class="avatar-lg mb-3" alt="" />
                <h5 class="mb-0">@ViewBag.UserName</h5>
                <div class="muted-small mb-3">@ViewBag.UserMail</div>
                <div class="row text-center">
                    <div class="col-6"><div class="h4 mb-0">@ViewBag.CountComment</div><div class="muted-small">Kommentare</div></div>
                    <div class="col-6"><div class="h4 mb-0">@ViewBag.ReservationCount</div><div class="muted-small">Bestätigte Reisen</div></div>
                </div>
                <a asp-action="Edit" asp-route-id="@ViewBag.Userid" class="btn btn-primary btn-block mt-4"><i class="fas fa-pen mr-1"></i> Bearbeiten</a>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h4>Kommentare</h4></div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="empty-state"><i class="fas fa-comment-slash"></i>Dieser Benutzer hat noch keine Kommentare geschrieben.</div>
                }
                @foreach (var c in Model)
                {
                    <div class="comment-item @(c.status ? "" : "inactive")">
                        <img src="@c.DesImage" class="table-thumb" alt="" />
                        <div class="comment-body">
                            <div class="d-flex justify-content-between">
                                <a href="@Url.Action("Destiniton", "Destiniton", new { area = "", id = c.DestinationID })" target="_blank" class="font-weight-bold">@c.DesCity</a>
                                <span class="muted-small">@ViewHelpers.Date(c.CommentData)</span>
                            </div>
                            <p class="mb-2">@c.CommentContent</p>
                            <form asp-controller="Comment" asp-action="Delate" asp-route-id="@c.id" asp-route-returnUrl="@Url.Action("Comments", new { id = ViewBag.Userid })" method="post" data-confirm="Kommentar löschen?">
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash mr-1"></i>Löschen</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        @Html.PagedListPager(Model, page => Url.Action("Comments", new { id = ViewBag.Userid, page }), ViewHelpers.Pager)
    </div>
</div>
