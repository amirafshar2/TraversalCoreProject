@model List<RoleViewModel>
@{
    ViewData["Title"] = "Rollen";
    ViewData["Subtitle"] = "Rollen steuern, welche Bereiche ein Benutzer sehen darf (ASP.NET Core Identity).";
}
@section HeaderActions {
    <a asp-action="Create" class="btn btn-primary btn-icon icon-left"><i class="fas fa-plus"></i> Neue Rolle</a>
}
<div class="row">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1">@r.Name @if (r.IsSystemRole) { <span class="badge badge-light ml-1">System</span> }</h5>
                            <p class="text-muted mb-2">@(string.IsNullOrEmpty(r.Description) ? "Keine Beschreibung" : r.Description)</p>
                        </div>
                        <div class="stat-icon bg-grad-@(r.Name == "Admin" ? "danger" : r.Name == "Moderator" ? "info" : "primary")" style="width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff">
                            <i class="fas fa-user-tag"></i>
                        </div>
                    </div>
                    <div class="muted-small mb-3"><i class="fas fa-users mr-1"></i>@r.UserCount Benutzer</div>
                    <div class="actions">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-primary"><i class="fas fa-pen mr-1"></i>Bearbeiten</a>
                        @if (!r.IsSystemRole)
                        {
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Rolle „@r.Name“ löschen?">
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash mr-1"></i>Löschen</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
