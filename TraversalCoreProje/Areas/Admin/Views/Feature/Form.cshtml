@model Feature
@{
    var isEdit = Model.FeatureId > 0;
    ViewData["Title"] = isEdit ? "Angebot bearbeiten" : "Neues Angebot";
}
<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="FeatureId" />
    <div class="row">
        <div class="col-lg-7">
            <div class="card"><div class="card-body">
                <div class="form-group">
                    <label asp-for="Title">Titel</label>
                    <input asp-for="Title" class="form-control" placeholder="z. B. Wochenende in Paris" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Preis / Untertitel</label>
                    <input asp-for="Description" class="form-control" placeholder="z. B. ab 690 €" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <label class="custom-switch m-0 p-0">
                    <input asp-for="Status" type="checkbox" class="custom-switch-input">
                    <span class="custom-switch-indicator"></span>
                    <span class="custom-switch-description">Aktiv</span>
                </label>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card"><div class="card-header"><h4>Bild</h4></div><div class="card-body">
                <img id="pv-f" src="@Model.Image" class="img-fluid rounded mb-3 @(string.IsNullOrEmpty(Model.Image) ? "d-none" : "")" alt="" />
                <input type="file" name="imageFile" accept="image/*" class="form-control" data-preview="#pv-f" />
                <span class="text-danger small">@Html.ValidationMessage("imageFile")</span>
            </div></div>
            <button class="btn btn-primary btn-lg btn-block"><i class="fas fa-save mr-2"></i>Speichern</button>
            <a asp-action="Index" class="btn btn-light btn-block">Abbrechen</a>
        </div>
    </div>
</form>
