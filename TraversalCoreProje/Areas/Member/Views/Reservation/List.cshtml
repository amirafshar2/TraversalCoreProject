@model IPagedList<Reservition>
@{
    ViewData["Title"] = ViewBag.Title;
    string status = ViewBag.Status;
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Pill(string a) => action == a ? "active" : "";
}
@section HeaderActions {
    <a asp-action="NewReservation" class="btn btn-primary btn-icon icon-left"><i class="fas fa-plus"></i> Neue Reservierung</a>
}
<ul class="nav nav-pills filter-pills mb-3">
    <li class="nav-item"><a class="nav-link @Pill("GetReservations")" asp-action="GetReservations"><i class="fas fa-clock mr-1"></i>Ausstehend <span class="badge badge-warning">@ViewBag.CountPending</span></a></li>
    <li class="nav-item"><a class="nav-link @Pill("AcceptedReservations")" asp-action="AcceptedReservations"><i class="fas fa-check mr-1"></i>Bestätigt <span class="badge badge-success">@ViewBag.CountApproved</span></a></li>
    <li class="nav-item"><a class="nav-link @Pill("CanceledReservations")" asp-action="CanceledReservations"><i class="fas fa-times mr-1"></i>Storniert <span class="badge badge-danger">@ViewBag.CountCanceled</span></a></li>
</ul>

@if (Model.Count == 0)
{
    <div class="card"><div class="card-body empty-state"><i class="fas fa-suitcase"></i>In dieser Kategorie gibt es keine Reservierungen.</div></div>
}
@foreach (var r in Model)
{
    <div class="card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3 mb-3 mb-md-0">
                    <img src="@r.Destiniton?.Image" class="img-fluid rounded" style="height:120px;width:100%;object-fit:cover" alt="" />
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-1">
                        <h5 class="mb-0 mr-2">@r.Destiniton?.City</h5> @ViewHelpers.StatusBadge(r.status)
                    </div>
                    <div class="muted-small mb-2">Reservierung #@r.id · gebucht am @ViewHelpers.Date(r.ReservDate)</div>
                    <div class="row small">
                        <div class="col-6"><i class="far fa-calendar-alt text-primary mr-1"></i> @ViewHelpers.Date(r.ReservStart) – @ViewHelpers.Date(r.ReservEnd)</div>
                        <div class="col-6"><i class="fas fa-users text-primary mr-1"></i> @r.HowmanyPapel Personen</div>
                        <div class="col-6 mt-1"><i class="fas fa-moon text-primary mr-1"></i> @ViewHelpers.Nights(r) Nächte</div>
                        <div class="col-6 mt-1"><i class="fas fa-compass text-primary mr-1"></i> @(r.Guide?.Name ?? "Kein Reiseführer")</div>
                    </div>
                </div>
                <div class="col-md-3 text-md-right mt-3 mt-md-0">
                    <div class="h5 text-primary font-weight-bold mb-2">@ViewHelpers.Euro(r.HowmanyPapel * (r.Destiniton?.Price ?? 0))</div>
                    <div class="actions">
                        <a href="@Url.Action("Destiniton", "Destiniton", new { area = "", id = r.Destintionid })" class="btn btn-sm btn-light" title="Reiseziel ansehen"><i class="fas fa-eye"></i></a>
                        @if (r.status != ReservationStatus.Canceled)
                        {
                            <a asp-action="Update" asp-route-id="@r.id" class="btn btn-sm btn-primary" title="Bearbeiten"><i class="fas fa-pen"></i></a>
                            <form asp-action="Delate" asp-route-id="@r.id" method="post" data-confirm="Möchten Sie diese Reservierung wirklich stornieren?">
                                <button class="btn btn-sm btn-outline-danger" title="Stornieren"><i class="fas fa-ban"></i> Stornieren</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@Html.PagedListPager(Model, page => Url.Action(action, new { page }), ViewHelpers.Pager)
