@model UserModel
@{
    ViewData["Title"] = "Mein Profil";
    var isProtected = (bool)ViewBag.IsProtected;
    var roles = (IList<string>)ViewBag.Roles;
}
<div class="row">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center">
                <img id="pv-profile" src="@Model.image" class="avatar-lg mb-3" alt="Profilbild" />
                <h5 class="mb-0">@Model.name @Model.surename</h5>
                <div class="muted-small mb-2">@Model.email</div>
                @foreach (var r in roles) { <span class="badge badge-light mr-1">@r</span> }
                <div class="muted-small mt-3">Mitglied seit @ViewHelpers.Date((DateTime)ViewBag.CreatedAt)</div>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h4>Passwort ändern</h4></div>
            <form asp-action="UpdatePassword" method="post">
                <div class="card-body">
                    @if (isProtected)
                    {
                        <div class="alert alert-light small mb-3"><i class="fas fa-lock mr-1"></i> Im Demo-Konto ist das Ändern des Passworts deaktiviert.</div>
                    }
                    <fieldset disabled="@isProtected">
                        <div class="form-group">
                            <label>Aktuelles Passwort</label>
                            <input type="password" name="passwordcurrent" class="form-control" autocomplete="current-password" />
                        </div>
                        <div class="form-group">
                            <label>Neues Passwort</label>
                            <input type="password" name="password" class="form-control" minlength="6" autocomplete="new-password" />
                        </div>
                        <div class="form-group mb-0">
                            <label>Neues Passwort wiederholen</label>
                            <input type="password" name="passwordconfirm" class="form-control" minlength="6" autocomplete="new-password" />
                        </div>
                    </fieldset>
                </div>
                <div class="card-footer text-right">
                    <button class="btn btn-warning" disabled="@isProtected"><i class="fas fa-key mr-1"></i> Passwort ändern</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h4>Persönliche Daten</h4></div>
            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Vorname</label>
                            <input name="name" value="@Model.name" class="form-control" required />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Nachname</label>
                            <input name="surename" value="@Model.surename" class="form-control" required />
                        </div>
                        <div class="form-group col-md-6">
                            <label>E-Mail</label>
                            <input name="email" type="email" value="@Model.email" class="form-control" readonly="@isProtected" />
                            @if (isProtected) { <small class="text-muted">Die E-Mail des Demo-Kontos ist fest.</small> }
                        </div>
                        <div class="form-group col-md-6">
                            <label>Telefon</label>
                            <input name="phone" value="@Model.phone" class="form-control" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Geschlecht</label>
                            <select name="gender" class="form-control">
                                @foreach (var g in new[] { "Frau", "Mann", "Divers" })
                                {
                                    <option value="@g" selected="@(Model.gender == g)">@g</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Profilbild</label>
                            <input type="file" name="ImageFile" accept="image/*" class="form-control" data-preview="#pv-profile" />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-right">
                    <button class="btn btn-primary"><i class="fas fa-save mr-1"></i> Speichern</button>
                </div>
            </form>
        </div>
    </div>
</div>
