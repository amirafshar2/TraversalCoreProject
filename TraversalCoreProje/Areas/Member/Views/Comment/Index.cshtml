@model IPagedList<Comment>
@{
    ViewData["Title"] = "Meine Kommentare";
    ViewData["Subtitle"] = "Ihre Bewertungen zu Reisezielen. Neue Kommentare schreiben Sie auf der Detailseite eines Reiseziels.";
}
<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state"><i class="fas fa-comment-slash"></i>Sie haben noch keine Kommentare geschrieben.<br /><a href="/Destiniton" class="btn btn-primary mt-3">Reiseziele ansehen</a></div>
        }
        @foreach (var c in Model)
        {
            <div class="comment-item @(c.status ? "" : "inactive")">
                <img src="@c.Destiniton?.Image" class="table-thumb" alt="" />
                <div class="comment-body">
                    <div class="d-flex flex-wrap justify-content-between">
                        <a href="@Url.Action("Destiniton", "Destiniton", new { area = "", id = c.Destinitonid })" class="font-weight-bold">@c.Destiniton?.City</a>
                        <span class="muted-small">@c.CommentData.ToString("dd.MM.yyyy HH:mm") · @ViewHelpers.ActiveBadge(c.status, "Veröffentlicht", "Vom Moderator ausgeblendet")</span>
                    </div>
                    <p class="mb-2 mt-1">@c.CommentContent</p>
                    <form asp-action="Delete" asp-route-id="@c.id" method="post" data-confirm="Kommentar löschen?">
                        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash mr-1"></i>Löschen</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page }), ViewHelpers.Pager)
