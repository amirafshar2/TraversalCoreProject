@model DemoOptions
@{
    ViewData["Title"] = "Live-Demo";
}
<partial name="_PageHero" model="@(("Live-Demo", "Probieren Sie Traversal ohne Registrierung aus – als Administrator oder als Kunde.", "/Traversal-Liberty/assets/images/banner3.jpg"))" />
<section class="py-5">
    <div class="container py-lg-4">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="feature-box">
                    <span class="fa fa-user-secret"></span>
                    <h4>Admin-Panel</h4>
                    <p>Dashboard mit Kennzahlen und Diagrammen, Reiseziele anlegen und bearbeiten, Reservierungen bestätigen oder stornieren,
                        Kommentare moderieren, Reiseführer, Benutzer &amp; Rollen, Website-Inhalte, Nachrichten und Newsletter verwalten.</p>
                    <a href="/Demo/Admin" class="btn btn-style btn-primary mt-2">Als Admin starten</a>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="feature-box">
                    <span class="fa fa-user"></span>
                    <h4>Kundenbereich</h4>
                    <p>Übersicht der eigenen Reisen, neue Reservierungen anfragen, Reservierungen bearbeiten oder stornieren,
                        Kommentare zu Reisezielen schreiben und das eigene Profil pflegen.</p>
                    <a href="/Demo/Member" class="btn btn-style btn-secondary mt-2">Als Kunde starten</a>
                </div>
            </div>
        </div>
        <div class="contact-card mt-2">
            <h4 style="font-weight:700">Technik</h4>
            <ul class="mb-3">
                <li>ASP.NET Core MVC (.NET 8) mit Areas (Admin, Member) und View Components</li>
                <li>N-Tier-Architektur: EntityLayer · DataAccessLayer (Repository-Pattern) · BusinessLayer (Manager/Services) · Präsentation</li>
                <li>Entity Framework Core mit SQLite (Datenbank liegt im Projekt, Code-First-Migrationen)</li>
                <li>ASP.NET Core Identity mit Rollen (Admin, Moderator, Member), FluentValidation, X.PagedList</li>
            </ul>
            <p class="small text-muted mb-0">Alle Änderungen sind erlaubt – die Datenbank wird alle @Model.ResetIntervalHours Stunden automatisch zurückgesetzt.
                Normale Anmeldung: <code>@Model.AdminEmail</code> bzw. <code>@Model.MemberEmail</code>, Passwort <code>@Model.DemoPassword</code>.</p>
        </div>
    </div>
</section>
