@model DestinationDetailViewModel
@{
    var d = Model.Destination;
    ViewData["Title"] = d.City;
    string highlightTitle = null, highlightText = d.Detail2;
    if (!string.IsNullOrEmpty(d.Detail2) && d.Detail2.Contains('\n'))
    {
        var parts = d.Detail2.Split('\n', 2);
        highlightTitle = parts[0].Trim();
        highlightText = parts[1].Trim();
    }
}
<partial name="_PageHero" model="@((d.City, d.Title1, d.CoverImage))" />

<section class="blog-post-main w3l-homeblock1 py-5">
    <div class="blog-content-inf pb-5">
        <div class="container pb-lg-4">
            <div class="dest-facts">
                <span><span class="fa fa-clock-o mr-1"></span> @d.DayNight</span>
                <span><span class="fa fa-eur mr-1"></span> ab @ViewHelpers.Euro(d.Price) p. P.</span>
                <span><span class="fa fa-users mr-1"></span> max. @d.Capacity Personen</span>
                <span><span class="fa fa-comments mr-1"></span> @Model.CommentCount Bewertungen</span>
            </div>

            @if (Model.Guide != null)
            {
                <div class="blog-post-align justify-content-center mb-5 mt-4">
                    <div class="blog-post-img"><img src="@Model.Guide.Image" alt="" class="rounded-circle img-fluid" style="width:60px;height:60px;object-fit:cover" /></div>
                    <div class="blog-post-info">
                        <div class="author align-items-center mb-1">Ihr Reiseführer: <a href="/Guide">@Model.Guide.Name</a></div>
                        <ul class="blog-meta"><li class="meta-item"><span class="meta-value">Traversal Reiseteam</span></li></ul>
                    </div>
                </div>
            }

            <div class="single-post-content">
                <p class="lead-text mb-4 text-pre">@d.Detail1</p>

                @if (!string.IsNullOrEmpty(highlightText))
                {
                    <blockquote class="blockquote my-5">
                        <div class="icon-quote"><span class="fa fa-quote-left" aria-hidden="true"></span></div>
                        @if (highlightTitle != null) { <strong class="d-block mb-2">@highlightTitle</strong> }
                        <span class="text-pre">@highlightText</span>
                    </blockquote>
                }

                @if (!string.IsNullOrEmpty(d.Title3)) { <h3 class="blog-desc-big m-0 mb-4">@d.Title3</h3> }
                <p class="mb-4 text-pre">@d.Detail3</p>

                <div class="sing-post-thumb mb-5 row pt-3">
                    <div class="col-sm-6"><img src="@d.Image2" class="img-fluid radius-image" alt="@d.City" style="height:320px;width:100%;object-fit:cover" loading="lazy"></div>
                    <div class="col-sm-6 mt-sm-0 mt-3"><img src="@d.Image3" class="img-fluid radius-image" alt="@d.City" style="height:320px;width:100%;object-fit:cover" loading="lazy"></div>
                </div>

                @if (!string.IsNullOrEmpty(d.Title4)) { <h3 class="blog-desc-big m-0 mb-lg-4 mb-3">@d.Title4</h3> }
                <p class="mb-4 text-pre">@d.Detail4</p>

                @if (!string.IsNullOrEmpty(d.Title5)) { <h3 class="blog-desc-big m-0 mt-5 mb-4">@d.Title5</h3> }
                <p class="mb-4 text-pre">@d.Detail5</p>

                <div class="booking-box">
                    <div>
                        <h4>@d.City – @d.DayNight</h4>
                        <p>Unverbindlich anfragen – wir bestätigen Ihre Reservierung schnellstmöglich.</p>
                    </div>
                    <div class="text-right">
                        <div class="price">@ViewHelpers.Euro(d.Price)<small style="font-size:14px;color:#fff;opacity:.7"> / Person</small></div>
                        <a href="@Url.Action("Index", "Reservation", new { area = "Member", id = d.DestinationID })" class="btn btn-style btn-secondary mt-2">Jetzt reservieren</a>
                    </div>
                </div>

                @await Component.InvokeAsync("_CommentPartial", new { id = d.DestinationID })

                @if (Model.Related.Any())
                {
                    <h3 class="related-title">Das könnte Sie auch interessieren</h3>
                    <div class="row dest-grid">
                        @foreach (var r in Model.Related)
                        {
                            <div class="col-md-4 mt-3">
                                <div class="dest-item">
                                    <a href="@Url.Action("Destiniton", new { id = r.DestinationID })" class="dest-img"><img src="@r.Image" alt="@r.City" style="height:170px" loading="lazy" /></a>
                                    <div class="dest-body">
                                        <h4 style="font-size:19px"><a href="@Url.Action("Destiniton", new { id = r.DestinationID })">@r.City</a></h4>
                                        <div class="dest-price"><strong style="font-size:18px">ab @ViewHelpers.Euro(r.Price)</strong></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
