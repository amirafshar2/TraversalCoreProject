@model DestinationListViewModel
@{
    ViewData["Title"] = "Reiseziele";
}
<partial name="_PageHero" model="@(("Reiseziele", "Städtereisen, Inselparadiese und Wanderwochen – finden Sie Ihre nächste Reise.", "/Traversal-Liberty/assets/images/banner1.jpg"))" />

<section class="py-5">
    <div class="container">
        <form method="get" class="filter-bar">
            <div class="row">
                <div class="col-md-6 mb-2 mb-md-0">
                    <input type="search" name="q" value="@Model.Search" class="form-control" placeholder="Wohin soll es gehen? z. B. Paris" />
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <select name="sort" class="form-control" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Neueste zuerst</option>
                        <option value="price-asc" selected="@(Model.Sort == "price-asc")">Preis aufsteigend</option>
                        <option value="price-desc" selected="@(Model.Sort == "price-desc")">Preis absteigend</option>
                        <option value="name" selected="@(Model.Sort == "name")">Name A–Z</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-style btn-primary btn-block" style="height:48px;padding:0"><span class="fa fa-search mr-1"></span> Suchen</button>
                </div>
            </div>
        </form>

        @if (!Model.Destinations.Any())
        {
            <div class="empty-hint">
                <span class="fa fa-map-o fa-3x mb-3 d-block"></span>
                Keine Reiseziele für „@Model.Search“ gefunden. <a href="/Destiniton">Alle anzeigen</a>
            </div>
        }
        <div class="row dest-grid mt-4">
            @foreach (var d in Model.Destinations)
            {
                <div class="col-lg-4 col-md-6 mt-4">
                    <div class="dest-item">
                        <a href="@Url.Action("Destiniton", new { id = d.DestinationID })" class="dest-img">
                            <img src="@d.Image" alt="@d.City" loading="lazy" />
                            <span class="dest-badge"><span class="fa fa-clock-o mr-1"></span>@d.DayNight</span>
                        </a>
                        <div class="dest-body">
                            <h4><a href="@Url.Action("Destiniton", new { id = d.DestinationID })">@d.City</a></h4>
                            <p>@d.Description</p>
                            <div class="dest-footer">
                                <div class="dest-price"><small>ab / Person</small><strong>@ViewHelpers.Euro(d.Price)</strong></div>
                                <a href="@Url.Action("Index", "Reservation", new { area = "Member", id = d.DestinationID })" class="btn btn-style btn-secondary btn-sm" style="padding:10px 18px">Reservieren</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
