@model Usermodel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Registrieren";
    ViewData["Image"] = "/img/destinations/malediven-1.jpg";
    ViewData["Headline"] = "Ihr nächstes Abenteuer wartet.";
    ViewData["Subline"] = "Erstellen Sie ein kostenloses Kundenkonto und reservieren Sie Ihre Traumreise in wenigen Klicks.";
}
<h1 class="auth-title">Konto erstellen</h1>
<p class="auth-sub">Bereits registriert? <a href="/User/Login">Anmelden</a> · oder <a href="/Demo/Member">Demo ohne Registrierung</a></p>

<form asp-action="registor" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="auth-error"></div>
    <div class="auth-row">
        <div class="auth-field">
            <label asp-for="Name">Vorname</label>
            <input asp-for="Name" autocomplete="given-name" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="Surname">Nachname</label>
            <input asp-for="Surname" autocomplete="family-name" />
            <span asp-validation-for="Surname" class="field-error"></span>
        </div>
    </div>
    <div class="auth-row">
        <div class="auth-field">
            <label asp-for="Email">E-Mail</label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="Telefonno">Telefon</label>
            <input asp-for="Telefonno" type="tel" autocomplete="tel" />
            <span asp-validation-for="Telefonno" class="field-error"></span>
        </div>
    </div>
    <div class="auth-row">
        <div class="auth-field">
            <label asp-for="Password">Passwort</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="PasswordConfirm">Passwort wiederholen</label>
            <input asp-for="PasswordConfirm" type="password" autocomplete="new-password" />
            <span asp-validation-for="PasswordConfirm" class="field-error"></span>
        </div>
    </div>
    <div class="auth-row">
        <div class="auth-field">
            <label asp-for="Gender">Geschlecht</label>
            <select asp-for="Gender">
                <option value="">Bitte wählen</option>
                <option value="Frau">Frau</option>
                <option value="Mann">Mann</option>
                <option value="Divers">Divers</option>
            </select>
            <span asp-validation-for="Gender" class="field-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="imagefile">Profilbild (optional)</label>
            <input asp-for="imagefile" type="file" accept="image/*" />
            <span asp-validation-for="imagefile" class="field-error"></span>
        </div>
    </div>
    <p class="auth-note">Demo-Hinweis: Bitte keine echten Daten verwenden. Alle Konten werden regelmäßig gelöscht.</p>
    <button type="submit" class="auth-submit">Registrieren</button>
</form>
<p class="auth-foot"><a href="/"><span class="fa fa-arrow-left"></span> Zurück zur Website</a></p>
