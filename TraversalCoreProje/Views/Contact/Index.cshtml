@model ContactPageViewModel
@{
    ViewData["Title"] = "Kontakt";
    var c = Model.Contact;
}
<partial name="_PageHero" model="@(("Kontakt", "Fragen zu einer Reise? Wir helfen gerne weiter.", "/Traversal-Liberty/assets/images/banner2.jpg"))" />

<section class="w3l-contact" id="contact">
    <div class="contact-infubd py-5">
        <div class="container py-lg-3">
            <div class="contact-grids row">
                <div class="col-lg-5 contact-left">
                    <div class="partners">
                        <div class="cont-details">
                            <h5>Schreiben Sie uns</h5>
                            <p class="mt-3 mb-4">@c?.Description</p>
                        </div>
                        <div class="hours">
                            <h6 class="mt-4">E-Mail:</h6>
                            <p><a href="mailto:@c?.Mail">@c?.Mail</a></p>
                            <h6 class="mt-4">Adresse:</h6>
                            <p>@c?.Adress</p>
                            <h6 class="mt-4">Telefon:</h6>
                            <p class="margin-top"><a href="tel:@c?.Phone?.Replace(" ", "")">@c?.Phone</a></p>
                        </div>
                        <p class="small text-muted mt-4"><span class="fa fa-info-circle mr-1"></span>Demo-Projekt: Die Kontaktdaten sind fiktiv. Nachrichten landen im Admin-Panel unter „Nachrichten“.</p>
                    </div>
                </div>
                <div class="col-lg-7 mt-lg-0 mt-5 contact-right">
                    <div class="contact-card">
                        @if (TempData["success"] is string ok)
                        {
                            <div class="alert-site success"><span class="fa fa-check-circle mr-1"></span>@ok</div>
                        }
                        <form asp-action="Index" method="post" class="signin-form">
                            <div class="input-grids">
                                <div class="form-group">
                                    <input asp-for="Message.Name" placeholder="Ihr Name*" class="contact-input" />
                                    <span asp-validation-for="Message.Name" class="field-error"></span>
                                </div>
                                <div class="form-group">
                                    <input asp-for="Message.Mail" type="email" placeholder="Ihre E-Mail*" class="contact-input" />
                                    <span asp-validation-for="Message.Mail" class="field-error"></span>
                                </div>
                                <div class="form-group">
                                    <input asp-for="Message.Subject" placeholder="Betreff*" class="contact-input" />
                                    <span asp-validation-for="Message.Subject" class="field-error"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <textarea asp-for="Message.Message" placeholder="Ihre Nachricht*"></textarea>
                                <span asp-validation-for="Message.Message" class="field-error"></span>
                            </div>
                            <p class="small text-muted">Mit dem Absenden erklären Sie sich damit einverstanden, dass Ihre Angaben zur Bearbeitung der Anfrage gespeichert werden. Bitte geben Sie in dieser Demo keine echten persönlichen Daten ein.</p>
                            <div class="text-right">
                                <button class="btn btn-style btn-primary">Nachricht senden</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
