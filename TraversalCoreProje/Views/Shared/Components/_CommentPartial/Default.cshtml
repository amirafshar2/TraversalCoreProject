@model List<TraversalCoreProje.Areas.Admin.Models.CommentWhitUserModel>
@{
    var desId = ViewData["desid"];
    var current = ViewData["CurrentUser"] as string;
}
<div class="comments-block" id="comments">
    <h3 class="comments-title mb-3">Bewertungen (<span id="comment-count">@Model.Count</span>)</h3>

    @if (current != null)
    {
        <form class="comment-form mb-4" id="comment-form">
            @Html.AntiForgeryToken()
            <div class="d-flex" style="gap:14px">
                <img src="@ViewData["ProfileImage"]" alt="" style="width:52px;height:52px;border-radius:50%;object-fit:cover" />
                <div class="flex-grow-1">
                    <textarea id="comment-text" maxlength="1000" placeholder="Wie hat Ihnen die Reise gefallen? Teilen Sie Ihre Erfahrung …" required></textarea>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted">Angemeldet als @current</small>
                        <button type="submit" class="btn btn-style btn-primary btn-sm" style="padding:10px 22px">Kommentar senden</button>
                    </div>
                    <div id="comment-error" class="field-error"></div>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="comment-login mb-4">
            <span class="fa fa-comments-o fa-2x mb-2 d-block"></span>
            Bitte <a href="/User/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + "#comments")">melden Sie sich an</a>, um eine Bewertung zu schreiben
            – oder testen Sie es direkt mit dem <a href="/Demo/Member">Demo-Kundenkonto</a>.
        </div>
    }

    <div id="comment-list">
        @if (!Model.Any())
        {
            <p class="text-muted" id="no-comments">Noch keine Bewertungen – schreiben Sie die erste!</p>
        }
        @foreach (var c in Model)
        {
            <div class="comment-card">
                <img src="@(c.UserImage ?? "/otika-bootstrap-admin-template/assets/img/users/user-2.png")" alt="" />
                <div>
                    <h6>@c.UserName @c.UserSurname</h6>
                    <span class="date">@c.CommentData.ToString("dd.MM.yyyy")</span>
                    <p>@c.CommentContent</p>
                </div>
            </div>
        }
    </div>
</div>
@if (current != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('comment-form');
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var text = document.getElementById('comment-text'), err = document.getElementById('comment-error');
                err.textContent = '';
                fetch('/Comment/AddComment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': form.querySelector('input[name=__RequestVerificationToken]').value },
                    body: JSON.stringify({ commentContent: text.value, destinationId: @desId })
                }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
                  .then(function (res) {
                      if (!res.ok || !res.j.success) { err.textContent = (res.j && res.j.message) || 'Fehler beim Senden.'; return; }
                      var c = res.j.comment, card = document.createElement('div');
                      card.className = 'comment-card';
                      var img = document.createElement('img'); img.src = c.image || '/otika-bootstrap-admin-template/assets/img/users/user-2.png';
                      var body = document.createElement('div');
                      var h = document.createElement('h6'); h.textContent = c.name;
                      var d = document.createElement('span'); d.className = 'date'; d.textContent = c.date;
                      var p = document.createElement('p'); p.textContent = c.content;
                      body.append(h, d, p); card.append(img, body);
                      var list = document.getElementById('comment-list'); list.prepend(card);
                      var none = document.getElementById('no-comments'); if (none) none.remove();
                      var cnt = document.getElementById('comment-count'); cnt.textContent = parseInt(cnt.textContent) + 1;
                      text.value = '';
                  }).catch(function () { err.textContent = 'Fehler beim Senden.'; });
            });
        });
    </script>
}
