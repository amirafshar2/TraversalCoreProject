<li class="dropdown">
    <a href="#" data-toggle="dropdown" class="nav-link dropdown-toggle nav-link-lg nav-link-user">
        <img alt="Profilbild" src="@(ViewBag.image ?? "/otika-bootstrap-admin-template/assets/img/users/user-2.png")" class="user-img-radious-style">
        <span class="d-sm-none d-lg-inline-block"></span>
    </a>
    <div class="dropdown-menu dropdown-menu-right pullDown">
        <div class="dropdown-title">Hallo, @ViewBag.name @ViewBag.surename</div>
        <a href="@Url.Action("Index", "Profile", new { area = "Member" })" class="dropdown-item has-icon">
            <i class="far fa-user"></i> Mein Profil
        </a>
        <a href="@Url.Action("Index", "Dashboard", new { area = "Member" })" class="dropdown-item has-icon">
            <i class="fas fa-suitcase-rolling"></i> Mein Kundenbereich
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
        {
            <a href="@Url.Action("Index", "Dashbord", new { area = "Admin" })" class="dropdown-item has-icon">
                <i class="fas fa-user-shield"></i> Admin-Panel
            </a>
        }
        <a href="/" class="dropdown-item has-icon">
            <i class="fas fa-globe-europe"></i> Zur Website
        </a>
        <div class="dropdown-divider"></div>
        <form method="post" asp-area="" asp-controller="User" asp-action="Logout" class="m-0">
            <button type="submit" class="dropdown-item has-icon text-danger btn-link-reset">
                <i class="fas fa-sign-out-alt"></i> Abmelden
            </button>
        </form>
    </div>
</li>
