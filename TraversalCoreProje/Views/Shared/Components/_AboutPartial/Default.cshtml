@model About2
@if (Model != null)
{
    <section class="w3l-bottom py-5" style="background-image:url('@Model.Image');background-size:cover;background-position:center">
        <div class="container py-md-4 py-3 text-center">
            <div class="row my-lg-4 mt-4">
                <div class="col-lg-9 col-md-10 ml-auto">
                    <div class="bottom-info ml-auto">
                        <div class="header-section text-left">
                            <h6 class="sub-title">@Model.Title2</h6>
                            <h3 class="hny-title two">@Model.Title1</h3>
                            <p class="mt-3 pr-lg-5">@Model.Descriotion</p>
                            <a href="/About" class="btn btn-style btn-secondary mt-5">Mehr über uns</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
