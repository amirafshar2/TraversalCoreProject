@model List<Guide>
@if (Model.Any())
{
    <section class="w3l-team" id="team">
        <div class="team-block py-5">
            <div class="container py-lg-5">
                <div class="title-content text-center mb-lg-3 mb-4">
                    <h6 class="sub-title">Unser Team</h6>
                    <h3 class="hny-title">Lernen Sie unsere Reiseführer kennen</h3>
                </div>
                <div class="row">
                    @foreach (var g in Model)
                    {
                        <div class="col-lg-3 col-6 mt-lg-5 mt-4">
                            <div class="box16">
                                <a href="/Guide"><img src="@g.Image" alt="@g.Name" class="img-fluid" loading="lazy" /></a>
                                <div class="box-content">
                                    <h3 class="title"><a href="/Guide">@g.Name</a></h3>
                                    <span class="post">Reiseführer</span>
                                    <ul class="social">
                                        <li><a href="@g.InstagramUrl" class="facebook" rel="noopener" aria-label="Instagram"><span class="fa fa-instagram"></span></a></li>
                                        <li><a href="@g.TwitterUrl" class="twitter" rel="noopener" aria-label="Twitter"><span class="fa fa-twitter"></span></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
