@if (ViewBag.name == null)
{
    <a class="btn btn-style btn-secondary header-btn" href="/User/Login"><span class="fa fa-sign-in mr-1"></span> Anmelden</a>
}
else
{
    <div class="dropdown user-menu">
        <button class="btn btn-style btn-secondary dropdown-toggle header-btn" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <img src="@ViewBag.Image" alt="" class="user-menu-img" /> @ViewBag.name
        </button>
        <div class="dropdown-menu dropdown-menu-right">
            @if (ViewBag.IsAdmin == true)
            {
                <a class="dropdown-item" href="/Admin/Dashbord"><span class="fa fa-dashboard mr-2"></span>Admin-Panel</a>
            }
            <a class="dropdown-item" href="/Member/Dashboard"><span class="fa fa-suitcase mr-2"></span>Mein Kundenbereich</a>
            <a class="dropdown-item" href="/Member/Reservation/GetReservations"><span class="fa fa-calendar mr-2"></span>Meine Reservierungen</a>
            <a class="dropdown-item" href="/Member/Profile"><span class="fa fa-user mr-2"></span>Profil</a>
            <div class="dropdown-divider"></div>
            <form method="post" asp-area="" asp-controller="User" asp-action="Logout" class="m-0">
                <button type="submit" class="dropdown-item text-danger"><span class="fa fa-sign-out mr-2"></span>Abmelden</button>
            </form>
        </div>
    </div>
}
