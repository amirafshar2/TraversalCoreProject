<div class="ai-chat">
    <div class="ai-chat-header">
        <i class="fas fa-magic mr-2"></i> KI-Reiseassistent
        <small class="d-block text-muted">Reisetipps zu jeder Stadt (Google Gemini)</small>
    </div>
    <div class="ai-chat-messages" id="ai-messages">
        @if ((bool)ViewBag.Enabled)
        {
            <div class="ai-msg ai-msg-bot">Geben Sie eine Stadt ein, z. B. <strong>Lissabon</strong>, und ich schlage Ihnen 7 Reisetipps vor.</div>
        }
        else
        {
            <div class="ai-msg ai-msg-bot">
                Der KI-Assistent ist in dieser öffentlichen Demo <strong>deaktiviert</strong>, da kein API-Schlüssel hinterlegt ist.
                Lokal kann er über <code>dotnet user-secrets set "Gemini:ApiKey" "…"</code> aktiviert werden.
            </div>
        }
    </div>
    <form class="ai-chat-input" id="ai-form" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="text" id="ai-city" class="form-control" maxlength="60" placeholder="Stadtname eingeben …" @((bool)ViewBag.Enabled ? "" : "disabled")>
        <button class="btn btn-primary" type="submit" @((bool)ViewBag.Enabled ? "" : "disabled")><i class="fas fa-paper-plane"></i></button>
    </form>
</div>
