@model ErrorViewModel
@{
    ViewData["Title"] = "Fehler";
}
<section class="error-page">
    <div class="container">
        <h1>500</h1>
        <h3 class="mb-3">Ein unerwarteter Fehler ist aufgetreten.</h3>
        @if (Model?.ShowRequestId == true)
        {
            <p class="text-muted">Fehler-ID: <code>@Model.RequestId</code></p>
        }
        <a href="/" class="btn btn-style btn-primary mt-3">Zur Startseite</a>
    </div>
</section>
